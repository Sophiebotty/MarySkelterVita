# Keep LF line endings in the repository AND in checkouts, regardless of the
# system-wide core.autocrlf=true in Git for Windows. build.sh and other
# scripts are run by bash in WSL and break with CRLF.
* text=auto eol=lf

# Binary files: never convert or diff as text.
*.png  binary
*.vpk  binary
*.velf binary
*.bin  binary
*.sfo  binary
